<mvc:View controllerName="project1ui5.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
    <VBox>
        <Title text="Teachers List" level="H2"/>
        <Table items="{namedModel>/teachers}">
          <columns>
            <Column><Text text="ID"/></Column>
            <Column><Text text="Name"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Active" press=".onTeacherPress">
              <cells>
                <Text text="{namedModel>id}" />
                <Text text="{namedModel>name}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <Title text="Students List" level="H2"/>
        <Table items="{/students}">
          <columns>
            <Column><Text text="ID"/></Column>
            <Column><Text text="Name"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Active" press=".onStudentPress">
              <cells>
                <Text text="{id}" />
                <Text text="{name}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </Page>
</mvc:View>